rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Transcripts
    match /transcripts/{transcriptId} {
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && incoming().userId == request.auth.uid
        && incoming().role in ['user', 'model', 'system']
        && incoming().text is string && incoming().text.size() <= 5000
        && incoming().timestamp is number;
      allow update, delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Tool Logs
    match /tool_logs/{logId} {
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && incoming().userId == request.auth.uid
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().status in ['executing', 'completed', 'failed']
        && incoming().timestamp is number;
      allow update: if isSignedIn() && existing().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // User Configs
    match /user_configs/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && incoming().userId == request.auth.uid
        && incoming().voiceName in ['Zephyr', 'Puck', 'Charon', 'Kore', 'Fenrir']
        && incoming().systemInstruction is string && incoming().systemInstruction.size() <= 2000;
      allow delete: if isOwner(userId);
    }
  }
}
