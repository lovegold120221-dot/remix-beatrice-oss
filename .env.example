# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Server port (default 5555 for this deployment)
PORT=5555

# APP_URL: The public URL where this app is hosted.
# Production: https://oss.eburon.ai (Let's Encrypt via reverse proxy)
APP_URL="https://oss.eburon.ai"

# Google OAuth Client (from Google Cloud Console)
# GOOGLE_CLIENT_SECRET only needed for server-side token exchange (keep secret)
# oAuthClientId goes in firebase-applet-config.json
# GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"
